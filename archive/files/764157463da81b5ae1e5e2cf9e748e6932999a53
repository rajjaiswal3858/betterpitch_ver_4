[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"In this guide, we'll introduce you to AI SDRs and show you how to implement them into your workflows to generate more ","marks":[],"data":{}},{"nodeType":"text","value":"qualified","marks":[{"type":"italic"}],"data":{}},{"nodeType":"text","value":" leads.","marks":[],"data":{}}]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"Understanding AI SDRs","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"With only ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.techtarget.com/white-paper-ebook/how-does-your-sales-development-program-measure-up/"},"content":[{"nodeType":"text","value":"17% of reps","marks":[{"type":"underline"}],"data":{}}]},{"nodeType":"text","value":" achieving 90% or higher of quota, AI SDRs are shifting from being a \"nice to have\" to becoming a major competitive advantage for sales teams.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"What is an AI SDR?","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"An AI SDR, or AI sales development representative, is software that uses artificial intelligence to perform the tasks typically handled by a human SDR.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The use cases of AI SDRs in sales teams vary. You might entrust them with the entire prospecting process or have them handle specific manual tasks, freeing up your human SDRs to focus on things that matter most. How deeply you integrate AI SDRs in your workflows depends on your comfort with the technology and the sophistication of your tech stack.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Further down the article, weâ€™ll give you all the information you need to choose the best approach for your business.","marks":[],"data":{}}]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"AI vs Human SDRs","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"When thinking about adding AI to your team, it's normal to ask, ","marks":[],"data":{}},{"nodeType":"text","value":"\"How does AI compare to human employees?\"Â ","marks":[{"type":"italic"}],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"So, let's break it down and explore the differences and benefits of each.","marks":[],"data":{}}]},{"nodeType":"heading-4","data":{},"content":[{"nodeType":"text","value":"AI SDRs","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"In  many instances, AI SDRs outperform human agents:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Scalable processes. ","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"Most","marks":[],"data":{}},{"nodeType":"text","value":" ","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"SDR tasks like cold outreach, follow-ups, and lead scoring are repeatable. With a well-structured process in place, AI can take over these tasks and reach your SDR quota way faster.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Consistent messaging. ","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"You donâ€™t have to worry about your messages sounding off. Unlike humans, AI sticks to the script.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Automated optimization. ","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"AI SDRs constantly evaluate their performance in the background and make adjustments on the fly. No need to spend hours poring over data.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Lower investment. ","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"Scaling SDR with AI doesnâ€™t come with payroll costs or extensive training programs.","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"\nAva is an AI SDR ready to take over your outbound prospecting. ","marks":[{"type":"bold"}],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.artisan.co/ai-sales-agent"},"content":[{"nodeType":"text","value":"Discover","marks":[{"type":"underline"}],"data":{}}]},{"nodeType":"text","value":" how she can accelerate your sales process.Â Â ","marks":[],"data":{}}]},{"nodeType":"heading-4","data":{},"content":[{"nodeType":"text","value":"Human SDRs","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Yet there are traits only inherent to human SDRs:Â ","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Decision-making in unscripted scenarios. ","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"While AI can make decisions based on data input, only human SDRs can manage situations that deviate from the ordinary.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Ability to build personal connection and rapport with customers. ","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"Humans can apply their personal traits and emotional intelligence to appeal to leads and create stronger connections with t