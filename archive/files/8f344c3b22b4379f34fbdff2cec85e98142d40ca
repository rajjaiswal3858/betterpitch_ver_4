ese small business owners are following some of the best sales advice ever given, straight from the pen of famous copywriter Gary Halbert in his ","marks":[],"data":{}},{"nodeType":"text","value":"Boron Letters","marks":[{"type":"italic"}],"data":{}},{"nodeType":"text","value":":","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Sell to a ravenous crowd.","marks":[{"type":"bold"}],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Also known as targeted lead generation.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"But this strategy isnâ€™t just for street meat vendors. It works wonders for B2B sales and marketing teams, too.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Today, youâ€™ll learn how to find and connect with your ravenous crowd.","marks":[],"data":{}}]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"What Is Targeted Lead Generation?","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Targeted lead generation happens when you narrow your scope to focus on attracting and connecting with highly specific segments of your potential market. These leads closely match your ideal customer profile (ICP)â€”they desperately need your solution.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Compared to general lead generation, targeted lead gen is laser-focused. Youâ€™re only engaging with leads that fulfill a certain set of criteria.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"To illustrate, a SaaS marketing agency might work with all forms of ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.artisan.co/blog/saas-demand-generation"},"content":[{"nodeType":"text","value":"SaaS businesses.","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"However, if they were doing targeted lead generation, they could focus their campaigns on a subset of that audience, the one theyâ€™re best equipped to helpâ€”like new SaaS startups with 1-10 employees struggling with outbound sales.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"This hyper-targeting allows for extremely personalized and relevant messaging.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"A sales rep ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.artisan.co/blog/cold-email-to-potential-client"},"content":[{"nodeType":"text","value":"cold emailing","marks":[],"data":{}}]},{"nodeType":"text","value":" small startup SaaS brands, for example, is going to have a much easier time identifying common pain points to include in the email copy than if they were cold emailing all types of SaaS brands.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"This level of specificity and relevancy is essential in today's attention economy, where decision-makers are bombarded with messages.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Also, from a cost standpoint, targeted lead generation helps you maximize your limited resources by focusing on the most promising prospects, rather than wasting time and money on broad, unfocused outreach.","marks":[],"data":{}}]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"Why Every Business Needs Targeted Lead Generation","marks":[],"data":{}}]},{"nodeType":"embedded-asset-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"kyprwggh4muz"}},"id":"F3arjN8EoNV2arLLQcMRU","type":"Asset","createdAt":"2025-02-25T19:57:16.557Z","updatedAt":"2025-02-25T19:57:16.557Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":2,"revision":1,"locale":"en-US"},"fields":{"title":"Benefits of Targeted Lead Generation","file":{"url":"//images.ctfassets.net/kyprwggh4muz/F3arjN8EoNV2arLLQcMRU/9ef5e8321d176de37f14c5fc9cb1c28b/Benefits_of_Targeted_Lead_Generation.webp","details":{"size":72268,"image":{"width":2663,"height":1790}},"fileName":"Benefits_of_Targeted_Lead_Generation.webp","contentType":"image/webp"}}}},"content":[]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Whether youâ€™re performing ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.artisan.co/blog/b2b-saas-lead-generation"},"content":[{"nodeType":"text","value":"B2B SaaS lead generation","marks":[{"type":"underline"}],"data":{}}]},{"nodeType":"text","value":", running ad campaigns for your solopreneurship, or generating new business for an enterprise company, the likelihood is that youâ€™ll benefit from targeted lead generation.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Higher Conversion Rates","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Reaching out to companies that ","marks":[],"data":{}},{"nodeType":"text","value":"need ","marks":[{"type":"italic"}],"data":{}},{"nodeType":"text","value":"your solution results in higher conversion rates across your sales and marketing campaigns.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Why?","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Because a higher percentage of the decision-makers you reach out to will find your offer valuable, or, at the very least, relevant to their day-to-day goals and concerns.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Itâ€™s like switching from a stick-and-shoestring bow to an industrial-grade crossbow.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"More shots hit the target.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Cost Efficiency","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"With targeted lead generation, your shooting percentage is higher.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Compared to broad lead generation, a targeted approach generates more revenue with less outreach, ad spend, and staff.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The result is greater cost efficiency.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Enhanced Customer Relationships","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"When customers receive tremendous value from your solution, theyâ€™re going to be happy and loyal.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"As a result, theyâ€™re going to recommend you to their peers, boosting referrals and lowering your customer acquisition costs.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Plus, theyâ€™re going to stick around, reducing churn.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Oh, and theyâ€™re not going to threaten to leave every month for your cheaper competitor like some toxic high school significant other.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Faster Sales Cycle","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"One of the most common reasons your ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.artisan.co/blog/sales-automation-process"},"content":[{"nodeType":"text","value":"sales cycle","marks":[],"data":{}}]},{"nodeType":"text","value":" lags is because leads arenâ€™t a good fit.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"You can serve them, sure. But their needs are less pronounced, and results are unlikely to match those of your ideal customers.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Therefore, theyâ€™re hesitant to buy (and rightfully so).","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Pending any feats of exaggeration from your sales team, they struggle to envision the high pay-off.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The best way to remedy this problem is to prevent low-quality leads from entering your pipeline in the first place. Targeted lead generation does this because it prioritizes only the leads that match your ICP.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Increased Brand Credibility","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Try and remember a time when you spoke to a serious authority on a subject. A doctor, perhaps. Or a professor or PhD student.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Odds are they gave the impression that they ","marks":[],"data":{}},{"nodeType":"text","value":"really ","marks":[{"type":"italic"}],"data":{}},{"nodeType":"text","value":"knew their subject. And you trusted their expertise.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"You can generate that same feeling in your prospects simply by niching down.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Compare these two sales messages:","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"â€œWe help hospitality businesses worldwideâ€","marks":[{"type":"italic"}],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"â€œWe help small bed and breakfast owners in Las Vegasâ€","marks":[{"type":"italic"}],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Which one sounds better to potential customers?","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The latter.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Why?","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Specificity implies expertise.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Leads think, â€œWow, this business is hyper-focused on serving companies like mine. They probably know my problems inside out.â€","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Another perk is that by consistently engaging with prospects in a smaller niche, you inevitably learn about their specific needs, which you can use to make your messaging even more resonant.","marks":[],"data":{}}]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"First, Understand How to Identify Your Target Audience","marks":[],"data":{}}]},{"nodeType":"embedded-asset-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"kyprwggh4muz"}},"id":"3e1aTuVnxPCksYt9uClMiN","type":"Asset","createdAt":"2025-02-25T19:57:16.561Z","updatedAt":"2025-02-25T19:57:16.561Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":2,"revision":1,"locale":"en-US"},"fields":{"title":"How to Identify Your Target Audience","file":{"url":"//images.ctfassets.net/kyprwggh4muz/3e1aTuVnxPCksYt9uClMiN/85739bee29f017af6978956ea50b0e6b/How_to_Identify_Your_Target_Audience.webp","details":{"size":69458,"image":{"width":3259,"height":1628}},"fileName":"How_to_Identify_Your_Target_Audience.webp","contentType":"image/webp"}}}},"content":[]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Before you can start reaching out to targeted leads, you must identify them.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The hot dog vendor doesnâ€™t wave her tongs at everyone who walks by. She waves it at the person leaving a bar who looks sweaty, famished, and lacking in impulse control.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"You must find your equivalent.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Letâ€™s cover tactics you can use to identify, understand, and define the businesses thatâ€™ll receive the most value from your product or service.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"1. Conduct Thorough Market Research","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The first step to targeted lead generation is to conduct market research.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"This enables you to create your ICP. You can think of the ICP as a more sophisticated, data-driven version of those drawings victims create of the person who stole their handbag. But instead of helping the cop find the thief, the ICP helps you pick your ideal leads out of a crowd.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"In the ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.artisan.co/blog/b2b-lead-nurturing"},"content":[{"nodeType":"text","value":"B2B sales world","marks":[],"data":{}}]},{"nodeType":"text","value":", an ICP often consists of company demographics, location, technographics, and pain points.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Hereâ€™s an example of an ICP that a B2B lead generation software company might use:","marks":[],"data":{}}]},{"nodeType":"embedded-asset-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"kyprwggh4muz"}},"id":"11J9Dt0QZbzJTYAAyM4Thw","type":"Asset","createdAt":"2025-02-25T19:57:04.455Z","updatedAt":"2025-02-25T19:57:04.455Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":3,"revision":1,"locale":"en-US"},"fields":{"title":"ICP Example","file":{"url":"//images.ctfassets.net/kyprwggh4muz/11J9Dt0QZbzJTYAAyM4Thw/269653149c8e1f118650203df1318653/icp_example.webp","details":{"size":345552,"image":{"width":2021,"height":3317}},"fileName":"icp_example.webp","contentType":"image/webp"}}}},"content":[]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Below are some quantitative and qualitative strategies for learning about your target buyers:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Sales data mining:","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" â€‹â€‹Review your CRM data to identify patterns among your most valuable customers.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Run surveys: ","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"Send surveys to current and potential customers to learn about their needs, pain points, and other details.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Conduct interviews: ","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"Set up interviews with your best customers to learn how they think about your product and why they chose to work with your business over others.","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"As you conduct your research, look for common industry verticals, company sizes, tech stacks, pain points, and goals.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Then plug the most common attributes into your ICP.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Soon, youâ€™ll have a high-definition picture of your ideal lead, which you can refer to during list-building, ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.artisan.co/blog/ai-prospecting-tools"},"content":[{"nodeType":"text","value":"prospecting","marks":[{"type":"underline"}],"data":{}}]},{"nodeType":"text","value":", ad targeting, and more.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"2. Create Detailed Buyer Personas","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Now that you have a good idea of what an ideal company looks like, itâ€™s time to get even more granular, defining the various types of decision-makers at the companies youâ€™ll target.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Youâ€™ll do this by creating buyer personas, semi-fictional representations of ideal customers based on data and insights.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"To illustrate, letâ€™s say youâ€™re running a software business thatâ€™s targeting property management companies in NYC that are struggling to manage local law compliance.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"A lot of people work in those businesses, from maintenance staff to CEOs.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"To narrow down your target audience, you create three buyer personas, each reflecting a different type of decision-maker in the company:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The VP of Property Management","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The Compliance Officer","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The CEO","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"For each, you define their demographics, worries, goals, responsibilities, communication channels, and other information that helps you understand this buyer.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"You create these personas much in the same way you built your ICPâ€”that is, through interviews, surveys, and reviews of past sales deals