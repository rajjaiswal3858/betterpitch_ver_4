ding-3","data":{},"content":[{"nodeType":"text","value":"Email Automation","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Writing the email is just the first step in cold outreach, and honestly, itâ€™s often the easiest. The real work comes afterâ€”scheduling the best times to send, making sure they land in the right inboxes, tracking engagement, and sending follow-up emails without missing any responses.Â ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"But you donâ€™t need to be on top of that 24/7 when youâ€™ve got automated workflows in place. Most good cold email software includes this functionality, and we made sure to only feature the ones that do.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"What exactly do we mean by email automation?","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" Here are some key features:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Automatically segmenting and updating leads based on their actions or traits","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Triggering email sequences in response to specific lead activity","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Scheduling emails (a must-have)","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Monitoring engagement and sending alerts","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Sending follow-up sequences based on how leads interact with your emails","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Email Deliverability","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Cold email campaigns often end up in spam folders, and the software you choose can either ","marks":[],"data":{}},{"nodeType":"text","value":"improve your odds or guarantee your emails stay stuck there.","marks":[{"type":"bold"}],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"First, thereâ€™s the issue of sender IP reputation. Most companies use shared IPs from their email platform without giving it much thought. But the thing is, different platforms have different standards for their shared IPs. If a platform has weak compliance and attracts spammers, its IPs will develop a bad reputation, and your emails could land in spam no matter what you do.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"So, start by checking whether the platform has a good shared IP reputation ","marks":[],"data":{}},{"nodeType":"text","value":"(you can find user feedback on forums to get a sense of their deliverability) ","marks":[{"type":"italic"}],"data":{}},{"nodeType":"text","value":"or if it offers dedicated IPs, which would allow you to manage your own reputation without relying on others.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Then, look at what steps the platform takes to boost your deliverability. This could include:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.artisan.co/ai-sales-agent"},"content":[{"nodeType":"text","value":"Email warmup","marks":[{"type":"underline"}],"data":{}}]},{"nodeType":"text","value":" services to build sender authority before you start outreachÂ ","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Automatically spreading out your email sends over several days","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Sharing deliverability stats","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Using AI to optimize deliverability over time","marks":[],"data":{}}]}]}]},{"nodeType":"embedded-asset-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"kyprwggh4muz"}},"id":"5E3KOWY1c9KIqNsRmPYcD0","type":"Asset","createdAt":"2024-09-26T19:32:06.416Z","updatedAt":"2024-09-26T19:32:06.416Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":8,"revision":1,"locale":"en-US"},"fields":{"title":"OPTIMIZED WARMUP","description":"A box divided into three sections with the following text: \"Optimizing Email Warmup 88%\", \"Mailbox 1 Optimized\", \"Mailbox 2 Optimized.\"","file":{"url":"//images.ctfassets.net/kyprwggh4muz/5E3KOWY1c9KIqNsRmPYcD0/98faf483f8ef668b8dde84916f346203/OPTIMIZED_WARMUP.webp","details":{"size":71178,"image":{"width":1512,"height":869}},"fileName":"OPTIMIZED WARMUP.webp","contentType":"image/webp"}}}},"content":[]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Analytics and Reporting","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"While every email service gives you some performance insights, it's important to know exactly what kind of data you're getting before you commit. Many tools only track open and click-through rates, which are helpful, but not enough to inform your future actions.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Great cold email software should go beyond that and ","marks":[],"data":{}},{"nodeType":"text","value":"offer detailed insights on deliverability, performance trends over time, and your top-performing campaigns.","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" Some AI-powered tools, like Artisan, even provide proactive recommendations or automatically optimize based on the data they gather.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Compatibility With Your Business Tools","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.salesforce.com/eu/resources/research-reports/state-of-crm/"},"content":[{"nodeType":"text","value":"Only one-third of businesses","marks":[{"type":"underline"}],"data":{}}]},{"nodeType":"text","value":" say they have a single view of customer information, yet 90% believe it would be valuable. So, whatâ€™s holding them back?","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"One big reason is poor technology integrationâ€”","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.sugarcrm.com/content/state-of-crm/"},"content":[{"nodeType":"text","value":"41% of teams","marks":[{"type":"underline"}],"data":{}}]},{"nodeType":"text","value":" struggle with it, according to research.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Building a well-integrated tech stack is critical but tough. Spare your team the extra challenge by making sure your cold emailing software smoothly integrates with the rest of your tools, especially your CRM system.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"ðŸ’¡ Artisan not only integrates seamlessly with your business tech stack but also replaces many tools in your fragmented outbound sales setup.","marks":[],"data":{}}]},{"nodeType":"embedded-asset-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"kyprwggh4muz"}},"id":"6iHcOZZs3cE0ZN7qF3Cutf","type":"Asset","createdAt":"2024-09-26T19:34:08.449Z","updatedAt":"2024-09-26T19:34:08.449Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":9,"revision":1,"locale":"en-US"},"fields":{"title":"Integrations ","description":"A screenshot with \"integrations\" on top of the page above a series of three companies along with their logos: Slack, HubSpot, and Salesforce. ","file":{"url":"//images.ctfassets.net/kyprwggh4muz/6iHcOZZs3cE0ZN7qF3Cutf/ba5e4943d36e53820969e9c3102e24dd/Screen_Shot_2024-09-26_at_12.32.59_PM.png","details":{"size":127865,"image":{"width":1546,"height":458}},"fileName":"Screen Shot 2024-09-26 at 12.32.59 PM.png","contentType":"image/png"}}}},"content":[]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"Contact Management and Segmentation","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"In fact, you might not even need additional business tools or a CRM system, with a good cold email tool. The best tools offer handy contact management features such as:","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Customer segmentation.","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" You should be able to group your contacts into segments based on shared characteristics.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Dynamic segmentation.","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" Ideally, segmentation should happen automatically, without manual intervention.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Lead qualification and prioritization.","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" While not essential, this is a huge bonus point. If your tool can automatically qualify leads based on predefined criteria or intent signals (using AI), you'll spend less time managing your pipeline and more time closing deals.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Custom fields.","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" At some point, youâ€™ll need the ability to adjust data and add extra fields for custom contact attributes.","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Lead enrichment. ","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":"Some software can even track lead activity and automatically update contact information.","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"With some or all of these features in your suite, youâ€™ll be able to set up laser-focused cold outreach campaigns without spending hours sifting through data.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"A/B Testing Capabilities","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Should you kick off your subject line with a hook or get straight to the point? Does longer copy perform better than short and snappy? Should you wait two or three days before following up?","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"You wonâ€™t know the answers until you test different approachesâ€”and your cold email platform should help with that.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Again, in different tools, A/B testing features vary. Some software only lets you test subject lines (often just two versions) and have strict audience size requirements, like a minimum of 500 contacts per test. Others offer more flexibility and allow multivariate tests with up to five email versions and a custom audience size.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Some platforms even let you test entire email automations, so you can figure out not only which copy works best but also which email sequence delivers the best results.","marks":[],"data":{}}]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"How to Choose the Best Cold Email Software","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Itâ€™s a lot to take in. Hereâ€™s a simple process to help you organize your thoughts and make the best decision.","marks":[],"data":{}}]},{"nodeType":"embedded-asset-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"kyprwggh4muz"}},"id":"2gY7Vzd7lZM82MKbVpzMhD","type":"Asset","createdAt":"2024-09-26T19:50:22.445Z","updatedAt":"2024-09-26T19:50:22.445Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":12,"revision":1,"locale":"en-US"},"fields":{"title":"How to Choose the Best Cold Email Software","description":"The headline \"How to Choose the Best Cold Email Software\" with the following numbered points: 1. Evaluate your specific needs and goals, 2. Match features to needs, 3. Consider your budget, 4. Take advantage of demos and trials, 5. Read reviews and customer feedback ","file":{"url":"//images.ctfassets.net/kyprwggh4muz/2gY7Vzd7lZM82MKbVpzMhD/94ef8fa19e8f1986ed28165d57259c14/How_to_Choose_the_Best_Cold_Email_Software.webp","details":{"size":111574,"image":{"width":1268,"height":910}},"fileName":"How to Choose the Best Cold Email Software.webp","contentType":"image/webp"}}}},"content":[]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"1. Evaluate Your Specific Needs and Goals","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Before diving into the sea of cold email software options, take a step back and think about what you want to achieve with your campaignsâ€”","marks":[],"data":{}},{"nodeType":"text","value":"and most importantly, how youâ€™re going to do that:","marks":[{"type":"italic"}],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"What are your end goalsâ€”are you looking to book demos, drive free trials, or close more high-ticket deals?","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Are you focusing on high-volume bulk emails, or do you need more personalized outreach?Â ","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Do you already have a list of leads, or is that something youâ€™re still working on?Â ","marks":[],"data":{}}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Answering these questions wonâ€™t take long, but itâ€™ll save you a lot of time on research later on.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"2. Match Features to Needs","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Now letâ€™s map your goals and methods with the features you should be looking for.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"If youâ€™re focused on sending bulk emails, youâ€™ll want a platform that offers solid email warmup tools, can handle multiple sender accounts, and helps optimize deliverability. If personalized outreach is your priority, look for features like lead enrichment and AI writing tools.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Also, consider where you are in your lead generation journey. If you already have leads, itâ€™s important to find software that integrates well with your existing CRM system (ideally, through a two-way sync). And if youâ€™re still building your list, lead discovery tools are something to look for.","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"3. Consider Your Budget","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"â€œThe lower the better, huh?â€","marks":[{"type":"italic"}],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Sure, going for the lowest price sounds greatâ€”until you realize youâ€™ve compromised on key features. While most cold outreach tools offer similar functionality, each has its strengths and weaknesses.Â ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Some platforms might bundle everything into one \"affordable\" plan, but that could mean the features you actually need fall short, like poor lead quality or basic integrations.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"You need to figure out whatâ€™s most important to you, and then focus on tools that excel in those areas. Once youâ€™ve narrowed it down, compare the pricing.Â ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"A lot of providers advertise starting prices as low as $20/month, but you may quickly find that the features or scale you actually need are locked behind a plan thatâ€™s ten times that price. This is especially painful to realize after youâ€™ve already spent weeks learning the tool on a free trial.","marks":[],"data":{}}]},{"nodeType":"embedded-asset-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"kyprwggh4muz"}},"id":"1WAo6RDbNJcZ3exWcyVu54","type":"Asset","createdAt":"2024-09-26T19:52:17.290Z","updatedAt":"2024-09-26T19:52:17.290Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":13,"revision":1,"locale":"en-US"},"fields":{"title":"PRICING TIERS","description":"Text advertising three different pricing tiers: \"Tier 1, 500 emails/month, $20 monthly\", \"Tier 2, 1,000 emails/month, $120 monthly\", \"Tier 3, Unlimited, Full access, $1,200 monthly.\" ","file":{"url":"//images.ctfassets.net/kyprwggh4muz/1WAo6RDbNJcZ3exWcyVu54/f91fa18eb4c593a56ce848576d4ab7a3/PRICING_TIERS.webp","details":{"size":71870,"image":{"width":1286,"height":911}},"fileName":"PRICING TIERS.webp","contentType":"image/webp"}}}},"content":[]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"4. Take Advantage of Demos and Trials","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Most cold email platforms offer free trials or demos, so donâ€™t hesitate to give them a try. While youâ€™re at it, check out how easy the platform is to use and how smoothly it integrates with your existing tools.Â ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"And hereâ€™s a tip: take note of the customer supportâ€”reach out, ask questions, and see how responsive and helpful they are.Â ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"ðŸ’¡ Artisan doesnâ€™t just offer support through live chat, calls, and documentation; we also gather feedback directly in the app to keep improving your experience. ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.artisan.co/talk-to-sales"},"content":[{"nodeType":"text","value":"Book a demo","marks":[{"type":"underline"}],"data":{}}]},{"nodeType":"text","value":" now to see our product and team in action!","marks":[],"data":{}}]},{"nodeType":"heading-3","data":{},"content":[{"nodeType":"text","value":"5. Read Reviews and Customer Feedback","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Before committing, make sure you read up on ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.onsaas.me/blog/sales-tools-for-prospecting"},"content":[{"nodeType":"text","value":"what other users are saying","marks":[],"data":{}}]},{"nodeType":"text","value":".Â ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Websites like G2 and Capterra are great places to start, but donâ€™t stop there. Go to forums like Reddit or Quora for some real-world insightsâ€”just be on the lookout for overly polished posts that might be coming from the companyâ€™s marketing team. Genuine feedback will usually share both the good and the bad, giving you a clearer picture.Â ","marks":[],"data":{}}]},{"nodeType":"blockquote","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"E